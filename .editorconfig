root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,gd,py}]
indent_style = tab
indent_size = 4

[SConstruct]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,cfg,gdextension,tres,tscn}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
