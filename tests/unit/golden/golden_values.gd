## Prints the [aero] section.
## Returns: nothing; prints the labelled values test_aero.cpp reads.
func print_aero() -> void:
	print("\n[aero]")
	# vehicle.gd process_drag():
	#     0.5 * air_density * pow(speed, 2.0) * frontal_area * coefficient_of_drag
	out("drag.20mps", 0.5 * 1.225 * pow(20.0, 2.0) * 2.0 * 0.3)
	out("drag.55.5mps_cd0.28_a2.2", 0.5 * 1.225 * pow(55.5, 2.0) * 2.2 * 0.28)
	out("drag.0", 0.5 * 1.225 * pow(0.0, 2.0) * 2.0 * 0.3)
